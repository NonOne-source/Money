{
  "name": "world-empire-online",
  "main": "worker.ts",
  "compatibility_date": "2025-06-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "EmpireRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "EmpireRoom"
      ]
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1:8787"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
